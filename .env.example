# YouTube Data API v3 key: used ONLY by scripts/find-videos.ts and scripts/check-videos.ts.
# Never prefix with NEXT_PUBLIC_; it must not ship to the browser.
YOUTUBE_API_KEY=

# Public site URL used for canonical links, sitemap and share images. Always the www origin, no trailing slash.
# Production builds (VERCEL_ENV=production) fail if this is anything else.
NEXT_PUBLIC_SITE_URL=https://www.hasronaldoscoredonyourbirthday.xyz
